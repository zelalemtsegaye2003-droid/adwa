generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Adwa Cyber — Phase 1 Compliance Platform ──────────────────────────────
// Organizations assessed against Proclamation No. 1321/2024

model Organization {
  id           String   @id @default(cuid())
  name         String
  nameAm       String   @default("")
  slug         String?  @unique
  sector       String // Banking | Microfinance | Telecom | SME | ...
  tier         String   @default("mid-market") // enterprise | mid-market | sme
  contactEmail String?
  status       String   @default("onboarding") // onboarding | active | pilot-complete
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  scans        Scan[]
  users        User[]
}

// The 47-rule catalogue mapped to articles of Proclamation 1321/2024
model Rule {
  id             String   @id @default(cuid())
  code           String   @unique // e.g. ART22-01
  sortOrder      Int
  article        String // "Art. 2"
  articleSubject String
  titleEn        String
  titleAm        String
  statementEn    String
  statementAm    String
  questionEn     String
  questionAm     String
  checkLogic     String
  remediationEn  String
  remediationAm  String
  pillar         String // Legal | Technical | Organisational | Awareness
  severity       String // critical | high | medium
  priority       String // P0 | P1
  penaltyRef     String
  weight         Int // 3 critical / 2 high / 1 medium
  version        String   @default("1.0")
  isActive       Boolean  @default(true)
  results        ScanResult[]
}

model Scan {
  id               String    @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  mode             String    @default("full")
  status           String    @default("in_progress") // in_progress | complete
  auditorName      String    @default("Adwa Compliance Engine")
  overallScore     Float?
  pillarScores     String? // JSON: {"Legal": 72.5, ...}
  findingsCount    Int       @default(0)
  criticalFindings Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  durationMinutes  Float?
  results          ScanResult[]
}

model ScanResult {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ruleId       String
  rule         Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  answer       String // yes | partial | no | na
  evidenceNote String?
  score        Float // 0 | 50 | 100 (na excluded)
  riskRank     Float?
  findingEn    String?
  findingAm    String?
  status       String   @default("open") // open | in_progress | remediated | waived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scanId, ruleId])
}

// ── Identity & Access (multi-tenant RBAC) ─────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String? // null for Google-only accounts
  name             String
  avatarUrl        String?
  role             String // SUPER_ADMIN | ORG_ADMIN | COMPLIANCE_OFFICER | AUDITOR | VIEWER
  organizationId   String? // null only for SUPER_ADMIN
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authProvider     String    @default("LOCAL") // LOCAL | GOOGLE
  googleId         String?   @unique
  status           String    @default("ACTIVE") // ACTIVE | DISABLED
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String? // AES-256-GCM encrypted TOTP secret
  mfaConfirmedAt   DateTime?
  backupCodes      String? // JSON array of sha256-hashed one-time codes
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime?
  sessionsRevokedAt DateTime? // access tokens issued BEFORE this moment are dead
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  refreshTokens    RefreshToken[]
  authEvents       AuthEvent[]
}

model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique // sha256 of the opaque token
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String? // id of the token that replaced it (rotation chain)
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
}

model AuthEvent {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  organizationId String?
  type           String // LOGIN_SUCCESS | LOGIN_FAILED | MFA_CHALLENGE | MFA_PASSED | MFA_FAILED | MFA_ENABLED | MFA_DISABLED | LOGOUT | TOKEN_REUSED | ACCOUNT_LOCKED | CAPTCHA_FAILED | USER_CREATED | USER_UPDATED | GOOGLE_LOGIN | REGISTER_ORG ...
  ip             String?
  userAgent      String?
  detail         String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId])
}

model CaptchaChallenge {
  id         String    @id @default(cuid())
  answerHash String // sha256(lowercased answer)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}
