# ── Adwa Cyber — environment configuration ─────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (development). NOTE: relative paths resolve against prisma/schema.prisma,
# so from the project root use ../db/custom.db or an absolute path:
DATABASE_URL=file:../db/custom.db
# PostgreSQL (production / docker compose — see docker-compose.yml):
# DATABASE_URL=postgresql://adwa:change-me@db:5432/adwa

# ── REQUIRED — session/crypto secret ──────────────────────────────────────
# 64+ chars of entropy. Signs JWTs (HS256) and derives the AES-256-GCM key
# that encrypts TOTP secrets at rest. Rotating it invalidates all sessions
# and MFA seeds (then re-run: bun scripts/fix-mfa-secret.ts).
# Generate: openssl rand -base64 48
AUTH_SECRET=

# ── Public origin (password-reset / email-verification links) ─────────────
# When unset the app derives it from the request. Set it explicitly when
# running behind a proxy so emailed links carry the public URL.
# APP_ORIGIN=https://platform.adwacyber.et

# ── Sign in with Google (OAuth 2.0 / OIDC) ────────────────────────────────
# Full step-by-step setup: docs/google-sso-setup.md
# Real provider — the exact callback URL to register in Google Cloud Console
# (APIs & Services → Credentials → OAuth client → Authorized redirect URIs):
#   https://YOUR_PUBLIC_HOST/api/auth/google/callback        (production)
#   http://localhost:3000/api/auth/google/callback           (local dev)
# The login screen shows the Google button automatically once the two values
# below are set; until then it shows "Google Sign-In is not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev-only mock provider (mini-services/mock-google on :3010):
# GOOGLE_CLIENT_ID=adwa-dev-mock-client.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=adwa-dev-mock-secret
# GOOGLE_AUTH_BASE=/mock-google/auth?XTransformPort=3010
# GOOGLE_TOKEN_URL=http://localhost:3010/token
# GOOGLE_JWKS_URL=http://localhost:3010/certs

# ── National CERT exchange (Ethio-CERT threat-intel sync + reporting) ─────
# When ETHIOCERT_API_URL is unset the synchronisation layer runs in fixture
# mode (bundled demo indicators, no network). Set both to bind live.
# Dev/pilot: point at the bundled mock (mini-services/mock-ethiocert :3020):
# ETHIOCERT_API_URL=http://localhost:3020
# ETHIOCERT_API_KEY=adwa-dev-ethiocert-key
# ETHIOCERT_TIMEOUT_MS=8000

# ── Ethiopian public web layer (Ethio-CERT advisories + INSA news) ───────
# The dashboard "Ethiopian Cyber Landscape" panel and the intel ribbon read
# the REAL public sites live; when unreachable they degrade to the bundled
# labelled snapshot captured from the real sites (bun run ethio:snapshot
# refreshes it). No key is required — these are public pages.
# ETHIOCERT_WEB_URL=https://www.ethiocert.gov.et
# INSA_NEWS_URL=https://www.insa.gov.et
# ETHIO_WEB_TIMEOUT_MS=8000
# ETHIO_WEB_OFF=            # true/1 → snapshot only (offline / air-gap mode)

# ── Public threat-intel feeds (SOC hub — Real-Data Roadmap Phase 1+2) ─────
# CISA KEV and Spamhaus DROP need NO key and are always live (they degrade to
# the bundled labelled snapshot only when the source is unreachable).
# The keyed feeds below activate the moment their free key is set — until
# then the UI honestly shows "key required" and syncs skip them.
# ABUSECH_AUTH_KEY=            # free key: https://auth.abuse.ch/ (URLhaus + ThreatFox; attribution required)
# OTX_API_KEY=                 # free key: https://otx.alienvault.com (subscribed community pulses)
# GREYNOISE_API_KEY=           # free Community key: https://greynoise.io (per-IP enrichment)
# MISP_URL=                    # self-hosted MISP instance, e.g. http://localhost:3030 (Phase 2 private exchange)
# MISP_API_KEY=                # its auth key (raw Authorization header) — MISP_URL+KEY ingest published events, TLP honoured
# VIRUSTOTAL_API_KEY=          # free key: https://www.virustotal.com (IP/URL/hash reputation; 4 req/min · 500/day)
# INTEL_FEED_TIMEOUT_MS=15000  # per-feed fetch timeout
# INTEL_FEED_MAX_ENTRIES=2000  # per-feed cap per run (honest capping, labelled)
# INTEL_FEEDS_OFF=             # true/1 kills every public connector (ops switch)

# ── Live EPSS enrichment (VAPT — Real-Data Roadmap §5.3) ────────────────
# FIRST publishes daily scores; the scan engine looks them up live (6h cache)
# and every finding's evidence labels its EPSS provenance. Keep the bundled
# snapshot current on a daily cron:
#   bun run vapt:epss
# EPSS_LIVE_OFF=               # true/1 → strictly bundled snapshot values (offline/air-gap mode)
# EPSS_TIMEOUT_MS=8000        # per-batch lookup timeout

# ── Email (password reset + verification) ─────────────────────────────────
# When SMTP_HOST is unset the console transport prints the emails (incl.
# reset links) to the server log — fine for demos, NOT for production.
# SMTP_HOST=smtp.example.et
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Adwa Cyber <no-reply@adwacyber.et>

# ── External captcha (built-in SVG captcha is used when unset) ────────────
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET=

# ── Docker compose only ───────────────────────────────────────────────────
# POSTGRES_USER=adwa
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=adwa
# SITE_ADDRESS=platform.adwacyber.et   # real domain → automatic Let's Encrypt
# SEED_ON_BOOT=1
